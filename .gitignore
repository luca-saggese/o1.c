# --- Upstream Python oracle (owned by upstream, never absorbed) ---
/python/

# --- Upstream reference checkout (read-only, never committed) ---
/_reference/

# --- Model weights ---
/models/*
!/models/manifest.json

# --- Evidence / artifacts (git-ignored per working mode) ---
/artifacts/

# --- HF caches ---
.cache/
.cache/huggingface/
~/.cache/huggingface/

# --- Build output ---
/build/
*.o
*.d
*.so
*.a
*.cu.o

# --- Generated runtime data ---
*.log
*.tmp
*.bin
/example_assets/generated/

# --- Python ---
__pycache__/
*.pyc
.venv/
venv/

# --- Local scratch (oracle venv, second reference checkout, ad-hoc outputs) ---
/.venv-oracle/
/_reference2/
/*-output.json
/*-output.png
/girl2.json
/girl2.png

# --- Release artifacts (definitions are tracked; weights are not) ---
/release/models/
/models/dev-orig/
